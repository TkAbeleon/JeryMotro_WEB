# JeryMotro Frontend Environment Variables (Example)
# Copy this file to '.env' and edit the values as needed.

# --- Port and Server ---
# The port on which the Vite development server will run
PORT=8080

# The base path of the application (useful if deployed on a subpath, e.g. /my-app/)
BASE_PATH=/

# --- API and Proxy ---
# Target URL for the local Vite proxy (redirects /jerymotro-api requests to this backend)
VITE_API_PROXY_TARGET=http://35.192.27.164

# Base URL for API requests.
# In development, keep this as "/jerymotro-api" to use the local Vite proxy.
# In production, this can be set to an absolute URL if needed (e.g. "https://jerymotro-api.duckdns.org")
VITE_API_URL=/jerymotro-api

# Initial/fallback backend availability.
# true = show the unavailable message by default until /health confirms the backend is online.
# false = do not show the message during the initial health check.
# If this variable is missing, the application defaults to true.
VITE_BACKEND_DEFAULT_OFFLINE=true

# --- Map Providers ---
# Google Maps API Key for satellite, terrain, and hybrid maps
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE
